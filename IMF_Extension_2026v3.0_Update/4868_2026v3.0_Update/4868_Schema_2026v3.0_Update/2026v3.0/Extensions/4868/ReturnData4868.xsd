<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.irs.gov/efile" xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xsd:annotation>
		<xsd:documentation>
			<Description>IRS e-file Income Tax Schema - Return Data for Form 4868</Description>
			<TaxYear>2026</TaxYear>
			<MaturityLevel>Final Drop 4 Schemas</MaturityLevel>
			<ReleaseDate>September 24, 2026</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>

	<xsd:include schemaLocation="../../Common/efileTypes.xsd" />
	<xsd:include schemaLocation="../../Common/BinaryAttachment.xsd" />	
	<xsd:include schemaLocation="IRS4868/IRS4868.xsd" />
	<xsd:include schemaLocation="../../Shared/Dependencies/ScannedPaperReturnUniqueDataStatement.xsd" />
	<xsd:include schemaLocation="../../IndividualIncomeTax/Common/Dependencies/IRSESPayment.xsd" />
	<xsd:include schemaLocation="../../CorporateIncomeTax/Common/Dependencies/IRSPayment.xsd" />
	<xsd:include schemaLocation="../../CorporateIncomeTax/Common/Dependencies/GeneralDependencySmall.xsd" />

	<xsd:element name="ReturnData">
		<xsd:annotation>
			<xsd:documentation>Content model for Return Data - Form 4868</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>

				<!-- Form 4868 -->
				<xsd:element ref="IRS4868"/>

				<!-- IRS Payment Record -->
				<xsd:element ref="IRSPayment" minOccurs="0" maxOccurs="unbounded"/>

				<!-- IRS ES Payment Record -->
				<xsd:element ref="IRSESPayment" minOccurs="0" maxOccurs="4"/>

				<xsd:element ref="BinaryAttachment" minOccurs="0" maxOccurs="unbounded">
					<xsd:annotation>
						<xsd:documentation>Binary Attachment</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				
				<!-- Scanned Paper Return (SPR) Unique Data Statement -->
				<xsd:element ref="SPRUniqueDataStatement" minOccurs="0">
					<xsd:annotation>
					  <xsd:documentation>Scanned Paper Return (SPR) Unique Data Statement</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				
				<!-- General Dependency Small for any Form/Schedule -->
				<xsd:element ref="GeneralDependencySmall" minOccurs="0" maxOccurs="unbounded">
					<xsd:annotation>
						<xsd:documentation>General Dependency Small (attachment not identified on the form or instructions)</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				
			</xsd:sequence>

			<xsd:attributeGroup ref="ReturnDataAttributes">
				<xsd:annotation>
					<xsd:documentation>Common return data attributes</xsd:documentation>
				</xsd:annotation>
			</xsd:attributeGroup>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
